# Copy to .env to override config/default.yaml locally. Format: GAMEQA_<SECTION>__<FIELD>
# GAMEQA_CONFIG_FILE=config/default.yaml
# GAMEQA_DEVICE=auto
# GAMEQA_VIDEO__ANALYSIS_FPS=12
# GAMEQA_LOGGING__LEVEL=DEBUG
# GAMEQA_LOGGING__JSON_FORMAT=true

# Backend (Phase 10-11). REQUIRED outside tests: a long random secret, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# GAMEQA_API__SECRET_KEY=change-me
# GAMEQA_DATABASE__URL=postgresql+psycopg://gameqa@localhost:5433/gameqa
